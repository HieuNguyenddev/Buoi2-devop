{
  "openapi": "3.0.1",
  "info": {
    "title": "Student CRUD API",
    "description": "API Quản lý sinh viên - ASP.NET Core & Entity Framework Core (SQL Server)",
    "version": "v1.0.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "Server hiện tại"
    }
  ],
  "paths": {
    "/api/student": {
      "get": {
        "tags": [
          "Student"
        ],
        "summary": "Lấy danh sách tất cả sinh viên (hỗ trợ tìm kiếm theo từ khóa và lớp)",
        "parameters": [
          {
            "name": "keyword",
            "in": "query",
            "description": "Từ khóa tìm kiếm theo họ tên, mã SV hoặc email",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "className",
            "in": "query",
            "description": "Lọc theo tên lớp học (ví dụ: CNTT-K15A)",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Danh sách sinh viên",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Student"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Student"
        ],
        "summary": "Thêm mới một sinh viên vào hệ thống",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StudentInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Thêm mới thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Student"
                }
              }
            }
          },
          "400": {
            "description": "Dữ liệu không hợp lệ hoặc mã sinh viên đã tồn tại"
          }
        }
      }
    },
    "/api/student/{id}": {
      "get": {
        "tags": [
          "Student"
        ],
        "summary": "Lấy thông tin chi tiết một sinh viên theo ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Thông tin sinh viên",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Student"
                }
              }
            }
          },
          "404": {
            "description": "Không tìm thấy sinh viên với ID tương ứng"
          }
        }
      },
      "put": {
        "tags": [
          "Student"
        ],
        "summary": "Cập nhật thông tin sinh viên theo ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Student"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cập nhật thành công"
          },
          "400": {
            "description": "Dữ liệu không hợp lệ hoặc ID không khớp"
          },
          "404": {
            "description": "Không tìm thấy sinh viên"
          }
        }
      },
      "delete": {
        "tags": [
          "Student"
        ],
        "summary": "Xóa vĩnh viễn một sinh viên khỏi hệ thống theo ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Xóa thành công"
          },
          "404": {
            "description": "Không tìm thấy sinh viên"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Student": {
        "type": "object",
        "required": [
          "id",
          "studentCode",
          "fullName",
          "className",
          "gpa"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "studentCode": {
            "type": "string",
            "example": "SV001"
          },
          "fullName": {
            "type": "string",
            "example": "Nguyễn Văn An"
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date-time",
            "example": "2003-05-15T00:00:00Z"
          },
          "className": {
            "type": "string",
            "example": "CNTT-K15A"
          },
          "gpa": {
            "type": "number",
            "format": "double",
            "example": 8.5
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "an.nguyen@example.com"
          }
        }
      },
      "StudentInput": {
        "type": "object",
        "required": [
          "studentCode",
          "fullName",
          "className",
          "gpa"
        ],
        "properties": {
          "studentCode": {
            "type": "string",
            "example": "SV006"
          },
          "fullName": {
            "type": "string",
            "example": "Nguyễn Văn Nam"
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date-time",
            "example": "2003-01-01T00:00:00Z"
          },
          "className": {
            "type": "string",
            "example": "CNTT-K16A"
          },
          "gpa": {
            "type": "number",
            "format": "double",
            "example": 8.0
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "nam.nguyen@example.com"
          }
        }
      }
    }
  }
}
