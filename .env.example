# =================================================================
# File mẫu cấu hình môi trường (.env.example)
# Sao chép thành file .env để cấu hình local
# =================================================================

# Môi trường chạy ứng dụng (Development / Production)
ASPNETCORE_ENVIRONMENT=Production

# Cổng khởi chạy HTTP của Kestrel
ASPNETCORE_URLS=http://localhost:5000

# Chuỗi kết nối SQL Server
CONNECTIONSTRINGS__DEFAULTCONNECTION=Server=localhost,1433;Database=QuanLySinhVienDB;User Id=sa;Password=YourStrongPassword123;TrustServerCertificate=True;
